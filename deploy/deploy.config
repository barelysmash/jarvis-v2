# JARVIS deploy configuration
# Sourced by all deploy scripts.

# ─── Hosts ──────────────────────────────────────────────────────
# The bastion host you can SSH to from your local machine
BASTION_HOST="${BASTION_HOST:-barelysmash@barelysmash}"

# The target host (resolved from bastion)
TARGET_HOST="${TARGET_HOST:-guildenstern}"

# The user JARVIS will run as on the target
TARGET_USER="${TARGET_USER:-ocelia}"

# The user on the bastion (for clarity in logs)
BASTION_USER="${BASTION_USER:-barelysmash}"

# ─── Paths ──────────────────────────────────────────────────────
# Local source root - one level up from this script
LOCAL_SOURCE="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# Bastion staging directory
BASTION_STAGING="/tmp/jarvis-deploy-staging"

# Target install paths
TARGET_HOME="/home/${TARGET_USER}"
TARGET_INSTALL="${TARGET_HOME}/jarvis"
TARGET_VENV="${TARGET_HOME}/jarvis-venv"
TARGET_DATA="${TARGET_HOME}/jarvis-data"
TARGET_RELEASES="${TARGET_HOME}/jarvis-releases"

# ─── Service config ─────────────────────────────────────────────
PYTHON_VERSION="${PYTHON_VERSION:-python3.12}"

# Long-running services - will be enabled and started
SERVICES=("jarvis-api")

# Optional voice service - uncomment if deploying with mic/speakers
# SERVICES+=("jarvis-voice")

# Timers - scheduled workflows
TIMERS=("jarvis-briefing.timer" "jarvis-sleep.timer")

# Number of releases to keep for rollback
KEEP_RELEASES=5

# ─── Build artifact ─────────────────────────────────────────────
RELEASE_NAME="jarvis-$(date +%Y%m%d-%H%M%S)"
RELEASE_TARBALL="/tmp/${RELEASE_NAME}.tar.gz"
