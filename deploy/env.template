# Production environment variables for JARVIS on guildenstern
# Copy to deploy/.env and fill in. This file is shipped to the target as-is.

# ─── Required ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# ─── JARVIS preferences ─────────────────────────────────────────
JARVIS_USER_NAME=Sir
JARVIS_TIMEZONE=America/Chicago
JARVIS_DATA_DIR=/home/ocelia/jarvis-data
JARVIS_LOG_LEVEL=INFO

# ─── Voice (optional - only if jarvis-voice service is enabled) ─
PORCUPINE_ACCESS_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
JARVIS_VOICE_ID=

# ─── Google integrations (optional) ─────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/home/ocelia/jarvis-data/google/credentials.json
GOOGLE_CREDENTIALS_PATH=/home/ocelia/jarvis-data/google/credentials.json
GOOGLE_TOKEN_PATH=/home/ocelia/jarvis-data/google/token.json

# Spotify (HUD miniplayer and voice control). All three or none; without
# them the miniplayer shows idle and the spotify agent is skipped.
# The refresh token is minted once on rosencrantz. Since mid-2026 Spotify
# expires refresh tokens six months after authorization, so expect to redo it.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REFRESH_TOKEN=

# Taxdesk (public Texas sales tax and mixed-beverage data). No token: the
# service is tailnet-only. Blank = agent skipped.
TAXDESK_BASE_URL=http://100.113.110.44:8770

# Mailbox (read-only). JARVIS reads guildensternai@gmail.com only — the
# address is fixed in tools/integrations/gmail_inbox.py and the token's
# account is checked before the first read. Point this at a Gmail OAuth token
# file (JSON with client_id, client_secret, refresh_token); the one Atlas
# already uses for that mailbox works. Blank = agent skipped.
EMAIL_TOKEN_FILE=
# Whole words that mark a restaurant nightly report (comma-separated).
# Matching mail is left out of search and cannot be opened. Default EOD,SPLH.
EMAIL_BLOCKED_TERMS=EOD,SPLH

# Timers the routine_run tool may start (comma-separated globs). Default:
# JARVIS's own routines, the briefing and the Atlas refresh. Everything else
# is listed by routines_list but can only be started from the cockpit.
# JARVIS_RUN_TIMERS=jarvis-routine-*.timer,jarvis-briefing.timer,atlas-*.timer

# Atlas RestaurantOS peer service (operational intelligence)
# Read-only; relative figures only. The token is the same value as
# ATLAS_API_TOKEN in ~/atlas-data/env/atlas.env. Blank = agent skipped.
ATLAS_BASE_URL=http://127.0.0.1:8790
ATLAS_API_TOKEN=
ATLAS_TIMEOUT_SECONDS=20
# Morning briefing raises an alarm when Atlas's newest service night is more
# than this many days old. Default 3 (a Monday briefing normally sees 2).
ATLAS_STALE_DAYS=3

# Phone notifications, through the ntfy server on guildenstern. Reminders,
# timers, Atlas alerts and a briefing-ready notice are pushed; the brain can
# also send on request. Blank URL or topic = off. The public ntfy.sh service
# is refused: the URL must be a server you run.
NTFY_BASE_URL=
NTFY_TOPIC=
# Access token for that server (starts tk_). Blank only if the topic is open.
NTFY_TOKEN=

# Friday production analysis service
# Analysis-only; no brokerage or order-execution permission.
FRIDAY_BASE_URL=http://127.0.0.1:8082
FRIDAY_API_TOKEN=
FRIDAY_TIMEOUT_SECONDS=45

# ─── Cockpit (second-screen detail view) ────────────────────────
# Shared secret sub-agents send as "Authorization: Bearer <token>" when
# POSTing key changes to /api/events. Leave blank to disable ingest.
JARVIS_EVENTS_TOKEN=
# How long the cross-process event log keeps history (pruned nightly).
JARVIS_EVENT_RETENTION_DAYS=7
# Which systemd --user timers the cockpit lists (comma-separated globs).
JARVIS_COCKPIT_TIMERS=*.timer
