# Production environment variables for JARVIS on guildenstern
# Copy to deploy/.env and fill in. This file is shipped to the target as-is.

# ─── Required ───────────────────────────────────────────────────
ANTHROPIC_API_KEY=
TAVILY_API_KEY=

# ─── JARVIS preferences ─────────────────────────────────────────
JARVIS_USER_NAME=Sir
JARVIS_TIMEZONE=America/Chicago
JARVIS_DATA_DIR=/home/ocelia/jarvis-data
JARVIS_LOG_LEVEL=INFO

# ─── Voice (optional - only if jarvis-voice service is enabled) ─
PORCUPINE_ACCESS_KEY=
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
JARVIS_VOICE_ID=

# ─── Google integrations (optional) ─────────────────────────────
GOOGLE_APPLICATION_CREDENTIALS=/home/ocelia/jarvis-data/google/credentials.json
GOOGLE_CREDENTIALS_PATH=/home/ocelia/jarvis-data/google/credentials.json
GOOGLE_TOKEN_PATH=/home/ocelia/jarvis-data/google/token.json

# Friday production analysis service
# Analysis-only; no brokerage or order-execution permission.
FRIDAY_BASE_URL=http://127.0.0.1:8082
FRIDAY_API_TOKEN=
FRIDAY_TIMEOUT_SECONDS=45
