[Unit]
Description=JARVIS Memory Sleep Cycle (decay + summarize)

[Service]
Type=oneshot
WorkingDirectory=%h/jarvis
EnvironmentFile=%h/jarvis/deploy/.env
ExecStart=%h/jarvis-venv/bin/python scripts/run_sleep_cycle.py nightly
StandardOutput=append:%h/jarvis-data/logs/sleep.log
StandardError=append:%h/jarvis-data/logs/sleep.err.log
