[Unit]
Description=JARVIS routine: conformance-sweep — Nightly JAM conformance sweep: clone every conforming repo, run `jam validate --json`, diff against the previous run, report drift; watch JAM for releases and prepare adoption branches for repos behind.

[Service]
Type=oneshot
WorkingDirectory=%h/jarvis
EnvironmentFile=%h/jarvis-data/env/jarvis.env
Environment=JARVIS_PROC=routine
ExecStart=%h/jarvis-venv/bin/python scripts/run_routine.py conformance-sweep
TimeoutStartSec=31min
StandardOutput=append:%h/jarvis-data/logs/routine-conformance-sweep.log
StandardError=append:%h/jarvis-data/logs/routine-conformance-sweep.err.log
